---
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default />
<div class="rc-docs-legal">
	<p>
		<strong>Not affiliated with Sony or Insomniac.</strong> ReRAC is an unofficial fan project, not affiliated with or
		endorsed by Sony Interactive Entertainment or Insomniac Games. Ratchet &amp; Clank and all related names are
		trademarks of their respective owners. ReRAC contains no game assets.
	</p>
</div>

<style>
	.rc-docs-legal {
		margin-top: 2.5rem;
		padding-top: 1.25rem;
		border-top: 1px solid var(--sl-color-hairline);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.rc-docs-legal strong {
		color: var(--sl-color-gray-2);
	}
</style>
