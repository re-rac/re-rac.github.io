---
import Default from '@astrojs/starlight/components/SocialIcons.astro';
import { launcherDownloadEnabled } from '../config';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

{
	launcherDownloadEnabled ? (
		<a class="rc-dl" href={`${base}#download`}>Download</a>
	) : (
		<a class="rc-dl rc-dl--soon" href={`${base}status/`} title="Not released yet. See how far ReRAC has come.">
			Coming soon
		</a>
	)
}
<Default />

<style>
	.rc-dl {
		--bev: 7px;
		padding: 0.4rem 0.85rem;
		font-family: var(--rc-font-display);
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--rc-space-950);
		background: var(--rc-grad-bolt);
		clip-path: polygon(var(--bev) 0, 100% 0, 100% calc(100% - var(--bev)), calc(100% - var(--bev)) 100%, 0 100%, 0 var(--bev));
	}
	.rc-dl:hover {
		filter: brightness(1.1);
		color: var(--rc-space-950);
	}
	.rc-dl--soon,
	.rc-dl--soon:hover {
		color: var(--rc-steel-200);
		background: linear-gradient(180deg, var(--rc-space-700), var(--rc-space-800));
		box-shadow: inset 0 0 0 1px rgb(129 144 189 / 0.45);
	}
</style>
