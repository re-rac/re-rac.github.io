---
import BaseLayout from '../layouts/BaseLayout.astro';
import SpaceScene from '../components/SpaceScene.astro';
import DownloadCta from '../components/DownloadCta.astro';
import Panel from '../components/Panel.astro';
import ScreenshotSlot from '../components/ScreenshotSlot.astro';
import Wordmark from '../components/Wordmark.astro';
import { screenshots } from '../data/screenshots';
import { formatUpdated, highlights, updated } from '../data/status';
import { siteName, siteTagline, thirdPartyArt } from '../config';
import { link } from '../lib/url';
import type { ImageMetadata } from 'astro';

// Third-party art (src/assets/third-party/README.md). Each piece is used only when enabled in src/config.ts, and the
// page still builds if the files are deleted: the hero then shows only the ReRAC logo and no picture.
const art = import.meta.glob<{ default: ImageMetadata }>('../assets/third-party/*.webp', { eager: true });
const gameLogo = thirdPartyArt.logo ? art['../assets/third-party/rac1-logo.webp']?.default : undefined;
const heroArt = thirdPartyArt.background ? art['../assets/third-party/rac1-bg.webp']?.default : undefined;

// The screenshot row appears once at least one slot has a real capture (src/data/screenshots.ts).
const shots = screenshots.filter((s) => s.image);

const faq = [
	{
		q: 'Can I play it now?',
		a: 'Not yet. Nothing has been released, and the game can’t be played from start to finish yet.',
	},
	{
		q: 'Which copy of the game do I need?',
		a: 'For now, the original North American PlayStation 2 disc.',
		more: { text: 'Here’s exactly which one.', href: 'docs/supported-versions/' },
	},
	{
		q: 'Will there be mods?',
		a: 'Yes, that’s the plan. You’ll install them and switch them on or off in the launcher, once the game itself is done.',
	},
];
---

<BaseLayout>
	<!-- HERO -->
	<section class="hero" aria-labelledby="hero-title">
		<SpaceScene />
		<div class:list={['container hero__grid', { 'hero__grid--solo': !heroArt }]}>
			<div class="hero__copy">
				<h1 id="hero-title" class="hero__title">
					<Wordmark size="hero" alt={siteName} loading="eager" />
					{
						gameLogo && (
							<img class="hero__game-logo" src={gameLogo.src} width={gameLogo.width} height={gameLogo.height} alt="for Ratchet & Clank" />
						)
					}
					<span class="hero__headline">{siteTagline}</span>
				</h1>
				<p class="hero__pitch">
					ReRAC is a fan-made PC port of the 2002 PlayStation&nbsp;2 classic. It runs natively on your computer, using your
					own copy of the game.
				</p>
				<DownloadCta />
			</div>
			{
				heroArt && (
					<div class="hero__visual">
						<div class="monitor">
							<div class="monitor__screen">
								<img src={heroArt.src} width={heroArt.width} height={heroArt.height} alt="Ratchet swinging on a grapple line above a sunlit city of towers" loading="eager" decoding="async" />
								<div class="monitor__scan" aria-hidden="true"></div>
							</div>
							<div class="monitor__bar" aria-hidden="true">
								<span class="led led--green"></span>
								<span class="monitor__bar-fill"></span>
							</div>
						</div>
					</div>
				)
			}
		</div>
	</section>

	<!-- WHAT IS -->
	<section class="section" id="what" aria-labelledby="what-title">
		<div class="container">
			<header class="section__head">
				<h2 id="what-title">What is ReRAC?</h2>
			</header>

			<ol class="steps">
				<li>
					<Panel tone="bolt" as="div" class="step">
						<h3>Runs natively</h3>
						<p>ReRAC runs on your computer like any other PC game, with no emulator to set up.</p>
					</Panel>
				</li>
				<li>
					<Panel tone="teal" as="div" class="step">
						<h3>Your copy of the game</h3>
						<p>
							ReRAC doesn’t come with the game. The launcher reads it from your own disc once, and then you’re ready to
							play.
						</p>
					</Panel>
				</li>
				<li>
					<Panel tone="steel" as="div" class="step">
						<h3>One launcher</h3>
						<p>The ReRAC Launcher sets everything up, keeps ReRAC up to date and starts the game.</p>
					</Panel>
				</li>
			</ol>

			{
				shots.length > 0 && (
					<div class="shots shots--after" aria-label="Screenshots">
						{shots.map((s, i) => <ScreenshotSlot slot={s} index={i} />)}
					</div>
				)
			}
		</div>
	</section>

	<!-- STATUS -->
	<section class="section section--alt" id="status" aria-labelledby="status-title">
		<div class="container">
			<Panel tone="steel" as="div" class="status">
				<div class="status__head">
					<h2 id="status-title">Where it stands</h2>
					<p class="status__badge"><span class="led led--amber" aria-hidden="true"></span>In development</p>
				</div>
				<p class="status__lede">
					ReRAC isn’t finished, and nothing has been released yet. For now it’s tested only on Macs with Apple Silicon;
					Windows and Linux are planned.
				</p>
				<div class="status__cols">
					<div>
						<h3><span class="led led--green" aria-hidden="true"></span>Working</h3>
						<ul class="checklist checklist--ok">{highlights.working.map((w) => <li>{w}</li>)}</ul>
					</div>
					<div>
						<h3><span class="led led--red" aria-hidden="true"></span>Still to come</h3>
						<ul class="checklist checklist--todo">
							{highlights.toCome.map((m) => <li>{m}</li>)}
							<li class="checklist__more"><a href={link('status/')}>…and more</a></li>
						</ul>
					</div>
				</div>
				<p class="status__foot">As of <time datetime={updated}>{formatUpdated()}</time>.</p>
			</Panel>
		</div>
	</section>

	<!-- FAQ -->
	<section class="section" id="faq" aria-labelledby="faq-title">
		<div class="container container--narrow">
			<header class="section__head">
				<h2 id="faq-title">Questions</h2>
			</header>
			<div class="faq">
				{
					faq.map((f) => (
						<details class="faq__item">
							<summary>{f.q}</summary>
							<p>
								{f.a}
								{f.more && (
									<>
										{' '}
										<a href={link(f.more.href)}>{f.more.text}</a>
									</>
								)}
							</p>
						</details>
					))
				}
			</div>
			<p class="faq__more">
				<a class="btn btn--ghost" href={link('docs/faq/')}>More questions</a>
				<a class="btn btn--ghost" href={link('docs/getting-started/')}>Getting started</a>
			</p>
		</div>
	</section>

	<!-- FINAL CTA -->
	<section class="section launchpad" aria-labelledby="launch-title">
		<SpaceScene horizon={false} class="scene--quiet" />
		<div class="container launchpad__inner">
			<h2 id="launch-title">Ready for launch?</h2>
			<p>Not quite yet. When the first release is out, you’ll find it here and in the <a href={link('docs/changelog/')}>changelog</a>.</p>
			<DownloadCta id="download-again" compact />
		</div>
	</section>
</BaseLayout>
