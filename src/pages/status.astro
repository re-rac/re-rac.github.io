---
import BaseLayout from '../layouts/BaseLayout.astro';
import Panel from '../components/Panel.astro';
import { gameRepoUrl } from '../config';
import { areas, formatUpdated, updated } from '../data/status';

// Everything on this page comes from src/data/status.ts, a hand-maintained estimate.
---

<BaseLayout title="Status" description="How far ReRAC has come, in a few rough estimates.">
	<section class="section status-page" aria-labelledby="status-page-title">
		<div class="container container--narrow">
			<header class="status-page__head">
				<h1 id="status-page-title" class="status-page__title">Where it stands</h1>
				<p class="status-page__lede">
					Here’s how far ReRAC has come. These are rough estimates and change as work lands.
				</p>
			</header>

			<Panel tone="steel" as="section" class="areas" aria-label="Progress by area">
				<ul class="areas__list">
					{
						areas.map((a, i) => (
							<li class="area">
								<div class="area__head">
									<h2 class="area__name">{a.name}</h2>
									<span class="area__pct">{a.percent}%</span>
								</div>
								<span class="gauge" aria-hidden="true" style={`--i: ${i}`}>
									<span class="gauge__fill" style={`--w: ${a.percent}`} />
								</span>
								<p class="area__text">{a.text}</p>
							</li>
						))
					}
				</ul>
			</Panel>

			<p class="status-page__foot">
				Last updated <time datetime={updated}>{formatUpdated()}</time>. For the details, see the{' '}
				<a href={gameRepoUrl}>project on GitHub</a>.
			</p>
		</div>
	</section>
</BaseLayout>

<style is:global>
	.status-page {
		padding-top: clamp(2.5rem, 6vw, 4.5rem);
	}
	.status-page__head {
		margin-bottom: 1.75rem;
	}
	.status-page__title {
		font-size: clamp(2.2rem, 1.5rem + 3vw, 3.5rem);
	}
	.status-page__lede {
		margin: 0;
		font-size: 1.12rem;
		color: var(--rc-text-muted);
	}
	.status-page__foot {
		margin: 1.25rem 0 0;
		font-size: 0.95rem;
		color: var(--rc-text-dim);
	}

	/* ---------- areas ---------- */

	.areas__list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.area + .area {
		margin-top: 1.6rem;
	}
	.area__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.45rem;
	}
	.area__name {
		margin: 0;
		font-size: clamp(1.15rem, 1rem + 0.5vw, 1.35rem);
	}
	.area__pct {
		font-family: var(--rc-font-mono);
		font-size: 0.95rem;
		color: var(--rc-bolt-300);
	}
	.area__text {
		margin: 0.6rem 0 0;
		color: var(--rc-text-muted);
	}

	/* ---------- the loading gauge ---------- */

	.gauge {
		--bev: 6px;
		--rivet: radial-gradient(circle, #dfe6ff 0 1.1px, #5d6a93 1.5px 2.6px, transparent 3px);
		position: relative;
		display: block;
		height: 1.1rem;
		padding: 3px 14px;
		background:
			var(--rivet) 3px 50% / 8px 8px no-repeat,
			var(--rivet) calc(100% - 3px) 50% / 8px 8px no-repeat,
			linear-gradient(180deg, #2c3868, #161f4a);
		clip-path: polygon(var(--bev) 0, 100% 0, 100% calc(100% - var(--bev)), calc(100% - var(--bev)) 100%, 0 100%, 0 var(--bev));
	}
	.gauge::before {
		/* the dark track */
		content: '';
		position: absolute;
		inset: 3px 14px;
		background: #040716;
		box-shadow: inset 0 1px 3px rgb(0 0 0 / 0.8);
	}
	.gauge::after {
		/* cell dividers over the track and fill */
		content: '';
		position: absolute;
		inset: 3px 14px;
		background: repeating-linear-gradient(90deg, transparent 0 calc(5% - 2px), rgb(4 7 22 / 0.85) calc(5% - 2px) 5%);
		pointer-events: none;
	}
	.gauge__fill {
		position: absolute;
		top: 3px;
		bottom: 3px;
		left: 14px;
		width: calc((100% - 28px) * var(--w) / 100);
		overflow: hidden;
		background: var(--rc-grad-bolt);
		box-shadow: 0 0 10px rgb(255 166 23 / 0.55), inset 0 1px 0 rgb(255 255 255 / 0.45);
		transform-origin: left center;
		animation: gauge-fill 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
		animation-delay: calc(var(--i, 0) * 80ms);
	}
	.gauge__fill::after {
		/* a slow sheen, like a charging bar */
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(100deg, transparent 20%, rgb(255 255 255 / 0.45) 45%, transparent 70%);
		transform: translateX(-120%);
		animation: gauge-sheen 3.2s ease-in-out 1.4s infinite;
	}
	@keyframes gauge-fill {
		from {
			transform: scaleX(0);
		}
	}
	@keyframes gauge-sheen {
		0% {
			transform: translateX(-120%);
		}
		60%,
		100% {
			transform: translateX(120%);
		}
	}
</style>
