---
import BaseLayout from '../layouts/BaseLayout.astro';
import Panel from '../components/Panel.astro';
import { areaCounts, areas, formatUpdated, planets, updated } from '../data/status';
import type { ItemState } from '../data/status';

// Everything on this page comes from src/data/status.ts, a hand-maintained estimate.
const groups: { state: ItemState; label: string; led: string }[] = [
	{ state: 'done', label: 'Done', led: 'green' },
	{ state: 'progress', label: 'In progress', led: 'amber' },
	{ state: 'todo', label: 'To come', led: 'red' },
];
---

<BaseLayout title="Status" description="How far ReRAC has come: each planet, and every part of the game.">
	<section class="section status-page" aria-labelledby="status-page-title">
		<div class="container">
			<header class="section__head">
				<h1 id="status-page-title" class="status-page__title">Where it stands</h1>
				<p class="status-page__lede">
					Here’s how far ReRAC has come. These are rough estimates and change as work lands.
				</p>
				<p class="status-page__updated">
					Last updated <time datetime={updated}>{formatUpdated()}</time>.
				</p>
			</header>

			<Panel tone="steel" as="section" class="planets" aria-labelledby="planets-title">
				<h2 id="planets-title" class="status-page__h2">Planets</h2>
				<p class="status-page__note">
					How much of each planet already works, from enemies and crates to doors and characters.
				</p>
				<ol class="planets__list">
					{
						planets.map((p, i) => (
							<li class="planet" style={`--i: ${i}`}>
								<span class="planet__name">{p.name}</span>
								<span class="gauge" aria-hidden="true">
									<span class="gauge__fill" style={`--w: ${p.percent}`} />
								</span>
								<span class="planet__pct">{p.percent}%</span>
							</li>
						))
					}
				</ol>
			</Panel>

			<h2 class="status-page__h2 status-page__h2--areas">Across the game</h2>
			<ul class="areas">
				{
					areas.map((a, i) => {
						const c = areaCounts(a);
						const donePct = (100 * c.done) / c.total;
						const progPct = (100 * c.progress) / c.total;
						return (
							<li>
								<Panel tone={a.name === 'Launcher' ? 'teal' : 'steel'} as="article" class="area">
									<div class="area__head">
										<h3>{a.name}</h3>
										<p class="area__count">
											{c.done} of {c.total} done
										</p>
									</div>
									<span class="gauge gauge--area" aria-hidden="true" style={`--i: ${i}`}>
										<span class="gauge__fill" style={`--w: ${donePct}`} />
										<span class="gauge__part" style={`--x: ${donePct}; --w: ${progPct}`} />
									</span>
									{groups.map((g) => {
										const items = a.items.filter((it) => it.state === g.state);
										return (
											items.length > 0 && (
												<div class="area__group">
													<h4>
														<span class={`led led--${g.led}`} aria-hidden="true" />
														{g.label}
													</h4>
													<ul class={`checklist checklist--${g.state}`}>
														{items.map((it) => (
															<li>{it.title}</li>
														))}
													</ul>
												</div>
											)
										);
									})}
								</Panel>
							</li>
						);
					})
				}
			</ul>
		</div>
	</section>
</BaseLayout>

<style is:global>
	.status-page {
		padding-top: clamp(2.5rem, 6vw, 4.5rem);
	}
	.status-page__title {
		font-size: clamp(2.2rem, 1.5rem + 3vw, 3.5rem);
	}
	.status-page__lede {
		font-size: 1.12rem;
		color: var(--rc-text-muted);
		margin-bottom: 0.4rem;
	}
	.status-page__updated {
		margin: 0;
		font-size: 0.9rem;
		color: var(--rc-text-dim);
	}
	.status-page__h2 {
		font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
		margin-bottom: 0.4rem;
	}
	.status-page__h2--areas {
		margin: clamp(3rem, 6vw, 4.5rem) 0 1.25rem;
	}
	.status-page__note {
		color: var(--rc-text-muted);
		margin-bottom: 1.5rem;
	}

	/* ---------- the loading gauge ---------- */

	.gauge {
		--bev: 6px;
		--rivet: radial-gradient(circle, #dfe6ff 0 1.1px, #5d6a93 1.5px 2.6px, transparent 3px);
		position: relative;
		display: block;
		height: 1.1rem;
		padding: 3px 14px;
		background:
			var(--rivet) 3px 50% / 8px 8px no-repeat,
			var(--rivet) calc(100% - 3px) 50% / 8px 8px no-repeat,
			linear-gradient(180deg, #2c3868, #161f4a);
		clip-path: polygon(var(--bev) 0, 100% 0, 100% calc(100% - var(--bev)), calc(100% - var(--bev)) 100%, 0 100%, 0 var(--bev));
	}
	.gauge::before {
		/* the dark track */
		content: '';
		position: absolute;
		inset: 3px 14px;
		background: #040716;
		box-shadow: inset 0 1px 3px rgb(0 0 0 / 0.8);
	}
	.gauge::after {
		/* cell dividers over the track and fill */
		content: '';
		position: absolute;
		inset: 3px 14px;
		background: repeating-linear-gradient(90deg, transparent 0 calc(5% - 2px), rgb(4 7 22 / 0.85) calc(5% - 2px) 5%);
		pointer-events: none;
	}
	.gauge__fill,
	.gauge__part {
		position: absolute;
		top: 3px;
		bottom: 3px;
		left: 14px;
		width: calc((100% - 28px) * var(--w) / 100);
		transform-origin: left center;
		animation: gauge-fill 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) both;
		animation-delay: calc(var(--i, 0) * 45ms);
	}
	.gauge__fill {
		overflow: hidden;
		background: var(--rc-grad-bolt);
		box-shadow: 0 0 10px rgb(255 166 23 / 0.55), inset 0 1px 0 rgb(255 255 255 / 0.45);
	}
	.gauge__fill::after {
		/* a slow sheen, like a charging bar */
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(100deg, transparent 20%, rgb(255 255 255 / 0.45) 45%, transparent 70%);
		transform: translateX(-120%);
		animation: gauge-sheen 3.2s ease-in-out 1.4s infinite;
	}
	.gauge__part {
		/* in progress: striped, dimmer, after the done part */
		left: calc(14px + (100% - 28px) * var(--x) / 100);
		background: repeating-linear-gradient(-45deg, rgb(255 194 51 / 0.55) 0 5px, rgb(255 194 51 / 0.18) 5px 10px);
		transform-origin: left center;
	}
	.gauge--area {
		margin: 0.2rem 0 1.1rem;
	}
	@keyframes gauge-fill {
		from {
			transform: scaleX(0);
		}
	}
	@keyframes gauge-sheen {
		0% {
			transform: translateX(-120%);
		}
		60%,
		100% {
			transform: translateX(120%);
		}
	}

	/* ---------- planets ---------- */

	.planets__list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		grid-template-rows: repeat(10, auto);
		grid-auto-flow: column;
		gap: 0.55rem 2.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.planet {
		display: grid;
		grid-template-columns: 8.5rem minmax(0, 1fr) 2.8rem;
		align-items: center;
		gap: 0.9rem;
	}
	.planet__name {
		font-family: var(--rc-font-display);
		font-size: 0.92rem;
		letter-spacing: 0.02em;
		color: var(--rc-steel-200);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.planet__pct {
		font-family: var(--rc-font-mono);
		font-size: 0.9rem;
		text-align: right;
		color: var(--rc-bolt-300);
	}

	/* ---------- areas ---------- */

	.areas {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.area__head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.25rem 1rem;
	}
	.area__head h3 {
		margin: 0 0 0.5rem;
	}
	.area__count {
		margin: 0;
		font-family: var(--rc-font-mono);
		font-size: 0.9rem;
		color: var(--rc-bolt-300);
	}
	.area__group + .area__group {
		margin-top: 0.8rem;
	}
	.area__group h4 {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin: 0 0 0.2rem;
		font-family: var(--rc-font-display);
		font-weight: 400;
		font-size: 0.78rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--rc-steel-300);
	}
	.status-page .area .checklist li {
		padding-top: 0.4rem;
		padding-bottom: 0.4rem;
		font-size: 0.95rem;
	}
	.status-page .area .checklist li::before {
		top: 0.8rem;
	}
	.status-page .checklist--done li::before {
		background: #45f07a;
	}
	.status-page .checklist--progress li::before {
		background: var(--rc-bolt-400);
	}

	@media (max-width: 60rem) {
		.planets__list,
		.areas {
			grid-template-columns: 1fr;
			grid-template-rows: none;
			grid-auto-flow: row;
		}
	}
	@media (max-width: 30rem) {
		.planet {
			grid-template-columns: 6.8rem minmax(0, 1fr) 2.6rem;
			gap: 0.6rem;
		}
		.planet__name {
			font-size: 0.82rem;
		}
	}
</style>
