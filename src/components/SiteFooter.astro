---
import { discordUrl, gameRepoUrl, launcherDownloadEnabled, launcherRepoUrl } from '../config';
import { link } from '../lib/url';
import Wordmark from './Wordmark.astro';
---

<footer class="site-footer">
	<div class="hazard" aria-hidden="true"></div>
	<div class="container site-footer__grid">
		<div class="site-footer__brand">
			<Wordmark />
			<p>A fan-made PC port of Ratchet &amp; Clank.</p>
		</div>
		<nav aria-label="Footer" class="site-footer__links">
			<div>
				<h2>Play</h2>
				<ul>
					{launcherDownloadEnabled && <li><a href={link('#download')}>Download</a></li>}
					<li><a href={link('status/')}>Status</a></li>
					<li><a href={link('docs/getting-started/')}>Getting started</a></li>
					<li><a href={link('docs/troubleshooting/')}>Troubleshooting</a></li>
					<li><a href={link('docs/faq/')}>FAQ</a></li>
				</ul>
			</div>
			<div>
				<h2>Project</h2>
				<ul>
					<li><a href={discordUrl}>Discord</a></li>
					<li><a href={gameRepoUrl}>Game repository</a></li>
					<li><a href={launcherRepoUrl}>Launcher repository</a></li>
					<li><a href={link('docs/changelog/')}>Changelog</a></li>
					<li><a href={link('docs/developers/')}>For developers</a></li>
				</ul>
			</div>
		</nav>
	</div>
	<div class="container site-footer__legal">
		<p>
			ReRAC is an unofficial fan project, not affiliated with or endorsed by Sony Interactive Entertainment or Insomniac
			Games. Ratchet &amp; Clank and related names are trademarks of their respective owners. ReRAC doesn’t include the
			game; you need your own copy.
		</p>
	</div>
</footer>
