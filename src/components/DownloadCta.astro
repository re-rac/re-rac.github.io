---
/**
 * The primary "Download the Launcher" call to action.
 *
 * Two switches in src/config.ts decide what renders:
 *   launcherDownloadEnabled  false: a disabled "Coming soon" button, no link and no script.
 *                            true: the button, server-rendered from the build-time release data. A small script
 *                            (DownloadCtaScript) then detects the visitor's OS and points it at the matching
 *                            installer. With no full release yet (only alpha/beta prereleases, which the stable
 *                            `releases/latest/download` links skip) it links to the launcher's releases page.
 *   showPlatformDownloads    the latest-release line, the platform cards and a short note under the button.
 */
import {
	latestDownloadUrl,
	launcherDownloadEnabled,
	launcherReleasesUrl,
	showPlatformDownloads,
} from '../config';
import { formatBytes, formatDate, getLauncherInfo } from '../lib/releases';
import { link } from '../lib/url';
import DownloadCtaScript from './DownloadCtaScript.astro';

interface Props {
	id?: string;
	compact?: boolean;
}
const { id = 'download', compact = false } = Astro.props;

const { latest, downloads } = await getLauncherInfo();
const anyAvailable = downloads.some((d) => d.available);
const version = latest?.tag.replace(/^v/i, '');
const released = latest ? formatDate(latest.publishedAt) : undefined;

const platformData = downloads
	.filter((d) => d.available)
	.map((d) => ({
		id: d.id,
		os: d.os,
		label: `${d.label} · ${d.detail}`,
		href: latestDownloadUrl(d.asset),
		size: d.size ? formatBytes(d.size) : '',
	}));

const osTags: Record<string, string> = { macos: 'MAC', windows: 'WIN', linux: 'LNX' };

/** The OS detection only has something to do when the button is live and a release has installers. */
const interactive = launcherDownloadEnabled && anyAvailable;
/** Without the platform list on the page, the no-JavaScript fallback is the releases page. */
const primaryHref = showPlatformDownloads ? `#${id}-platforms` : launcherReleasesUrl;
---

<div
	class:list={['cta', { 'cta--compact': compact, 'cta--soon': !anyAvailable, 'cta--off': !launcherDownloadEnabled }]}
	id={id}
	data-download-cta
	data-platforms={interactive ? JSON.stringify(platformData) : undefined}
>
	<span class="cta__glow">
		{!launcherDownloadEnabled ? (
			<span class="cta__primary cta__primary--off" role="link" aria-disabled="true">
				<span class="cta__primary-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="26" height="26">
						<circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="2.2" />
						<path d="M12 7.5V12l3 2" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</span>
				<span class="cta__primary-text">
					<span class="cta__primary-label">Coming soon</span>
				</span>
			</span>
		) : anyAvailable ? (
			<a class="cta__primary" href={primaryHref} data-cta-primary>
				<span class="cta__primary-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="28" height="28">
						<path d="M12 3v11m0 0-4.5-4.5M12 14l4.5-4.5M4 17v3h16v-3" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</span>
				<span class="cta__primary-text">
					<span class="cta__primary-label">Download the Launcher</span>
					<span class="cta__primary-sub" data-cta-sub>Choose your platform below</span>
				</span>
			</a>
		) : (
			<a class="cta__primary" href={launcherReleasesUrl}>
				<span class="cta__primary-icon" aria-hidden="true">
					<svg viewBox="0 0 24 24" width="28" height="28">
						<path d="M12 3v11m0 0-4.5-4.5M12 14l4.5-4.5M4 17v3h16v-3" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</span>
				<span class="cta__primary-text">
					<span class="cta__primary-label">Download the Launcher</span>
					<span class="cta__primary-sub">
						<span class="led led--amber" aria-hidden="true" />
						Early alpha, on GitHub
					</span>
				</span>
			</a>
		)}
	</span>

	{
		showPlatformDownloads && (
			<>
				<p class="cta__meta">
					{
						latest ? (
							<>
								<span class="led led--green" aria-hidden="true" />
								Latest launcher <strong>v{version}</strong> · released <time datetime={latest.publishedAt}>{released}</time>
								{' · '}
								<a href={latest.htmlUrl}>Release notes</a>
							</>
						) : (
							<>
								<span class="led led--amber" aria-hidden="true" />
								Nothing released yet. The <a href={link('docs/changelog/')}>changelog</a> will have it first.
							</>
						)
					}
				</p>

				<ul class="cta__platforms" id={`${id}-platforms`} aria-label="All platforms">
					{
						downloads.map((d) => (
							<li class="cta__platform" data-platform={d.id} data-os={d.os}>
								{d.available ? (
									<a href={latestDownloadUrl(d.asset)} class="cta__platform-link">
										<span class="cta__os-tag" aria-hidden="true">{osTags[d.os]}</span>
										<span class="cta__platform-name">
											{d.label} <span class="cta__platform-detail">{d.detail}</span>
										</span>
										<span class="cta__platform-size">{d.size ? formatBytes(d.size) : 'Download'}</span>
									</a>
								) : (
									<span class="cta__platform-link is-soon">
										<span class="cta__os-tag" aria-hidden="true">{osTags[d.os]}</span>
										<span class="cta__platform-name">
											{d.label} <span class="cta__platform-detail">{d.detail}</span>
										</span>
										<span class="cta__platform-size">Coming soon</span>
									</span>
								)}
							</li>
						))
					}
				</ul>

				{
					!compact && (
						<p class="cta__note">
							You’ll need your own copy of the game (<a href={link('docs/supported-versions/')}>which one?</a>). So far
							ReRAC is tested only on Macs with Apple Silicon.
							{latest && (
								<>
									{' '}
									<a href={launcherReleasesUrl}>All releases</a>
								</>
							)}
						</p>
					)
				}
			</>
		)
	}
</div>

{interactive && <DownloadCtaScript />}
