---
/** Original art: a hex bolt head, gold, seen slightly from above. */
interface Props {
	size?: number;
	class?: string;
	title?: string;
}
const { size = 32, class: className, title } = Astro.props;
const id = `b${Math.random().toString(36).slice(2, 8)}`;
---

<svg
	class={className}
	width={size}
	height={size}
	viewBox="0 0 64 64"
	role={title ? 'img' : undefined}
	aria-hidden={title ? undefined : 'true'}
	aria-label={title}
>
	<defs>
		<linearGradient id={`${id}-face`} x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color="#fff1b8" />
			<stop offset="0.35" stop-color="#ffc233" />
			<stop offset="1" stop-color="#d9670f" />
		</linearGradient>
		<linearGradient id={`${id}-side`} x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color="#c7680c" />
			<stop offset="1" stop-color="#7a3406" />
		</linearGradient>
		<radialGradient id={`${id}-hole`} cx="0.5" cy="0.4" r="0.6">
			<stop offset="0" stop-color="#3a1a04" />
			<stop offset="1" stop-color="#8a4608" />
		</radialGradient>
	</defs>
	<!-- side walls -->
	<path d="M8 26 L32 12 L56 26 L56 40 L32 54 L8 40 Z" fill={`url(#${id}-side)`} />
	<!-- top face -->
	<path d="M8 26 L32 12 L56 26 L32 40 Z" fill={`url(#${id}-face)`} />
	<path d="M8 26 L32 40 L32 54 L8 40 Z" fill="#b8570b" opacity="0.55" />
	<!-- threaded hole -->
	<ellipse cx="32" cy="26" rx="10" ry="5.8" fill={`url(#${id}-hole)`} />
	<ellipse cx="32" cy="25.2" rx="10" ry="5.8" fill="none" stroke="#fff6d6" stroke-opacity="0.55" stroke-width="1.2" />
	<!-- specular -->
	<path d="M14 25 L32 14.5 L40 19" fill="none" stroke="#fffbe8" stroke-width="1.6" stroke-linecap="round" opacity="0.8" />
</svg>
